{
  "manifest_version": 3,
  "name": "pkf-web2local",
  "short_name": "web2local",
  "version": "0.2.0",
  "description": "Connect xiangqiai.com to a local Pikafish engine.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "pkf-web2local"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xiangqiai.com/*"
      ],
      "js": [
        "pkf-web2local.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
